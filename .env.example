# ── Forge core ────────────────────────────────────────────────────────────────
# Profiles are created in the app (first visitor becomes admin) — there is no
# global password anymore. FORGE_PASSWORD is ignored since the multi-user
# release.
FORGE_SECRET_KEY=                  # token signing, generate: openssl rand -hex 32
FORGE_DB_PATH=/data/db/forge.db
FORGE_MODELS_DIR=/data/models
FORGE_SKILLS_DIR=/data/skills
FORGE_WORKSPACES_DIR=/data/workspaces

# ── Hardware budgets (see PLAN.md §2) ────────────────────────────────────────
FORGE_VRAM_BUDGET_GB=11        # per GPU
FORGE_RAM_OFFLOAD_BUDGET_GB=32
FORGE_GPU_COUNT=0              # 0 = auto-detect via NVML; one engine may run per GPU

# ── Sessions ─────────────────────────────────────────────────────────────────
FORGE_SESSION_IDLE_MIN=120
FORGE_MAX_PARALLEL_SESSIONS=4
FORGE_SESSION_MEM_LIMIT=4g         # per session container (docker mem_limit)

# ── Model registry ───────────────────────────────────────────────────────────
FORGE_REGISTRY_CRON=0 6 * * 1      # weekly Mon 06:00

# ── Chat & memory ────────────────────────────────────────────────────────────
FORGE_UPLOAD_MAX_MB=20             # per chat attachment
FORGE_MEMORY_TOKEN_BUDGET=700      # injected memory block cap (tokens)
FORGE_CHAT_CONTEXT_TOKENS=6000     # prompt budget before rolling compression

# ── Engines ──────────────────────────────────────────────────────────────────
FORGE_LLAMACPP_SLOTS=2
FORGE_ENGINE_LOAD_TIMEOUT_S=900    # healthwait cap per engine load (big GGUFs are slow)

# ── Optional integrations ────────────────────────────────────────────────────
HF_TOKEN=                          # optional, gated models
GITHUB_PAT=                        # optional, GitHub MCP

# ── SearXNG ──────────────────────────────────────────────────────────────────
# Secret key for the bundled search service. Leave blank: `make up` generates
# a value here on first run (openssl rand -hex 32).
SEARXNG_SECRET=

# ── Docker plumbing (defaults match docker-compose.yml; change only if you
#    rename the project or images) ───────────────────────────────────────────
FORGE_DOCKER_NETWORK=forge-internal
FORGE_MODELS_VOLUME=forge-models
FORGE_SKILLS_VOLUME=forge-skills
FORGE_WORKSPACES_VOLUME=forge-workspaces
FORGE_SESSION_IMAGE=forge-session-runner
FORGE_LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
FORGE_VLLM_IMAGE=vllm/vllm-openai:v0.10.1
FORGE_AIRLLM_IMAGE=forge-airllm
FORGE_IMAGEGEN_IMAGE=forge-imagegen
FORGE_SCRAPLING_IMAGE=ghcr.io/d4vinci/scrapling:v0.4.14
FORGE_HEADROOM_IMAGE=ghcr.io/headroomlabs-ai/headroom:0.35.0
FORGE_SMOLVM_IMAGE=forge-smolvm    # sandbox profile only (make sandbox, needs /dev/kvm)
